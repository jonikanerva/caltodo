#!/usr/bin/env bash
# e2e-run: the Playwright and axe journeys (STACK.md §11). Run it through
# `scripts/db.sh with-test-db`, which gives the run its own test server.
#
# Each run has its own client build, database, server port, and Playwright
# output directory (target/e2e/RUN), so two runs in one checkout do not share
# a file or a port. The release build of the test server is shared; Cargo
# locks the target directory, and an unchanged build stays the same file.
set -euo pipefail
: "${CALTODO_DB_CONTAINER:?run through scripts/db.sh with-test-db}"
: "${DATABASE_URL:?run through scripts/db.sh with-test-db}"
# The server of the run, without a database name.
server_url=${DATABASE_URL%/*}

root=$(git rev-parse --show-toplevel)
# A nested run (verify) reuses the container, so the database name is unique.
suffix=$(od -An -N4 -tx4 /dev/urandom | tr -d ' ')
run_dir="$root/target/e2e/$CALTODO_DB_CONTAINER-$suffix"
database="caltodo_e2e_$suffix"
mkdir -p "$run_dir"

# The journeys test the current client and test server.
pnpm --filter @caltodo/web exec vite build --outDir "$run_dir/web" --emptyOutDir --logLevel warn
cargo build --release --locked -p caltodo --example e2e_server

container exec "$CALTODO_DB_CONTAINER" psql --host 127.0.0.1 --username postgres \
  --dbname postgres --quiet --set ON_ERROR_STOP=1 --command "CREATE DATABASE $database"

# A free port from the system. Another process can take it before the server
# starts; then the server start fails and the run fails visibly.
port=$(node -e 'const s=require("net").createServer();s.listen(0,"127.0.0.1",()=>{console.log(s.address().port);s.close()})')

# Playwright starts the test server in its own process group. When the run
# ends early (SIGINT, SIGTERM), Playwright can exit before the server, so the
# exit trap stops the server of this port.
stop_server() {
  status=$?
  trap - EXIT
  pkill -TERM -f "target/release/examples/e2e_server --port $port " 2>/dev/null || true
  exit "$status"
}
trap stop_server EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

export E2E_PORT=$port
export E2E_DATABASE_URL="$server_url/$database"
export E2E_WEB_BUILD="$run_dir/web"
export E2E_OUTPUT_DIR="$run_dir/results"
echo "e2e-run: results in $E2E_OUTPUT_DIR" >&2
pnpm --filter @caltodo/e2e run e2e
# The results stay for inspection; the client build of a passed run goes.
rm -r "${run_dir:?}/web"
