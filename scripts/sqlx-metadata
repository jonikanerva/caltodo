#!/usr/bin/env bash
# sqlx-metadata check|prepare: compare (`check`) or write (`prepare`) the SQLx
# query metadata (.sqlx) against a freshly migrated database (STACK.md §3).
# Run it through `scripts/caltodo-pg with-test-db`, which gives the run its own
# test server in DATABASE_URL.
#
# `cargo sqlx prepare` writes target/sqlx-prepare-check and target/sqlx-tmp
# and touches source files, so one checkout runs one prepare at a time.
set -euo pipefail
mode=${1:-}
case $mode in
  check) extra=(--check) ;;
  prepare) extra=() ;;
  *)
    echo "usage: sqlx-metadata check|prepare" >&2
    exit 2
    ;;
esac
: "${CALTODO_PG_RUN_URL:?run through scripts/caltodo-pg with-test-db}"
: "${CALTODO_PG_RUN_CONTAINER:?run through scripts/caltodo-pg with-test-db}"

database="caltodo_sqlx_$(od -An -N4 -tx4 /dev/urandom | tr -d ' ')"
psql_admin() {
  container exec "$CALTODO_PG_RUN_CONTAINER" psql --host 127.0.0.1 --username postgres \
    --dbname postgres --quiet --set ON_ERROR_STOP=1 "$@"
}
cleanup() {
  status=$?
  trap - EXIT
  # The container of the run may be gone already (the run ended).
  psql_admin --command "DROP DATABASE IF EXISTS $database WITH (FORCE)" >/dev/null 2>&1 || true
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
psql_admin --command "CREATE DATABASE $database"
export DATABASE_URL="$CALTODO_PG_RUN_URL/$database"
# sqlx-cli applies the migrations without a build. A build of the server
# (`caltodo migrate`) compiles the queries against the committed metadata,
# so the build fails for a new or changed query.
sqlx migrate run --no-dotenv --source migrations
SQLX_OFFLINE=false "$(dirname "$0")/checkout-lock" sqlx-prepare -- \
  cargo sqlx prepare --no-dotenv --workspace ${extra[@]+"${extra[@]}"} -- --all-targets --locked
